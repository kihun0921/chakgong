# 이 파일은 템플릿이다. 실제 값은 .env.local(개발) / 서버의 .env.production(운영)에 넣고 GitHub에는 올리지 않는다.

# --- Supabase (이 서비스 전용 새 프로젝트, 서울 리전 권장) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 키. 절대 클라이언트 코드나 GitHub에 노출하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# --- 나라장터 오픈API (SR-IN-01) ---
NARA_SERVICE_KEY=

# --- 주민등록번호·계좌번호 등 필드 단위 암호화 키 (SR-NF-13), 임의의 긴 랜덤 문자열 ---
FIELD_ENCRYPTION_KEY=

# --- 로그인 세션 서명 키 (32자 이상 랜덤 문자열). 운영에서는 필수 ---
SESSION_SECRET=

# --- Gemini API (AI 보조: 공정 이름 정리·문안 초안·검증 설명·응대 문안, SR-AI-01) ---
# 서버 전용 키. 없으면 AI 보조가 꺼진다. 클라이언트 코드나 GitHub에 노출하지 않는다.
# 무료 키는 약관상 입력이 제품 개선에 쓰일 수 있으니 사용 전 Google 약관을 확인하고, 유료(결제 연결) 키 사용을 권장한다.
GEMINI_API_KEY=
# 모델 이름(비우면 gemini-3.8-flash). 모델이 단종되면 404가 나므로 그때 이 값을 바꾼다
GEMINI_MODEL=
